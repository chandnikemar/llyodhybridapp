class DonutChart extends StatelessWidget {
  final List<int> data;
  final List<Color> colors;
  final double total;
  final double radius;

  DonutChart({
    required this.data,
    required this.colors,
    required this.total,
    this.radius = 1,
  });

  @override
  Widget build(BuildContext context) {
    final double screenHeight = MediaQuery.of(context).size.height;
    final double donutHeight = screenHeight > 800
        ? 125
        : (screenHeight > 600 && screenHeight <= 800)
            ? 90
            : 100;
    return CustomPaint(
      size: Size(donutHeight, donutHeight), // Adjust size of the chart
      painter: DonutChartPainter(
        data: data,
        colors: colors,
        total: total,
        radius: radius,
      ),
    );
  }
}

class DonutChartPainter extends CustomPainter {
  final List<int> data;
  final List<Color> colors;
  final double total;
  final double radius;
  final double gapPercentage; // Added for spacing control

  DonutChartPainter({
    required this.data,
    required this.colors,
    required this.total,
    required this.radius,
    this.gapPercentage = 0.04, // Default gap percentage (1%)
  });

  @override
  void paint(Canvas canvas, Size size) {
    final Paint paint = Paint()
      ..style = PaintingStyle.stroke
      ..strokeWidth = radius
      ..strokeCap = StrokeCap.round; // This makes the edges rounded

    double startAngle = -pi / 2; // Start from the top
    double gapAngle =
        gapPercentage * 2 * pi; // Convert the gap percentage into radians

    // Iterate through each segment and draw them
    for (int i = 0; i < data.length; i++) {
      final double sweepAngle = (data[i] / total) * 2 * pi -
          gapAngle; // Adjust sweep angle to allow for gap
      paint.color = colors[i];

      // Draw each segment with a gap
      canvas.drawArc(
        Rect.fromCircle(
            center: Offset(size.width / 2, size.height / 2),
            radius: size.width / 2 - radius),
        startAngle,
        sweepAngle,
        false,
        paint,
      );

      // Update the start angle for the next segment, adding the gap angle as well
      startAngle += sweepAngle +
          gapAngle; // Include gap in the angle for the next segment
    }

    // Now draw the total count at the center of the chart
    final TextSpan textSpan = TextSpan(
      text: 'Total\n$total', // The total count to display
      style: TextStyle(
        fontSize: 12, // Adjust the font size as necessary
        fontWeight: FontWeight.bold,
        color: Colors.black,
      ),
    );

    final TextPainter textPainter = TextPainter(
      text: textSpan,
      textAlign: TextAlign.center,
      textDirection: TextDirection.ltr,
    );

    // Layout the text
    textPainter.layout(
      minWidth: 0,
      maxWidth: size.width,
    );

    // Draw the text in the center of the chart
    final Offset textOffset = Offset(
      (size.width - textPainter.width) / 2,
      (size.height - textPainter.height) / 2,
    );

    textPainter.paint(canvas, textOffset);
  }

  @override
  bool shouldRepaint(covariant CustomPainter oldDelegate) {
    return false;
  }
}


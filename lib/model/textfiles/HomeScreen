        val currentTime = System.currentTimeMillis()
        val tagData = reader.Actions.getReadTags(1)
        tagData?.let { tags ->
            for (tag in tags) {
                val tagId = tag.tagID
                if (!processedTags.contains(tagId) && (currentTime - lastTagReadTime) > DEBOUNCE_DELAY_MS) {
                    // Check if tag has not been processed and debounce delay has passed
                    Log.d("TAG", "Tag ID: $tagId")

                    if (tag.opCode == ACCESS_OPERATION_CODE.ACCESS_OPERATION_READ &&
                        tag.opStatus == ACCESS_OPERATION_STATUS.ACCESS_SUCCESS
                    ) {
                        if (tag.memoryBankData.isNotEmpty()) {
                            Log.d("TAG", "Mem Bank Data: ${tag.memoryBankData}")
                        }
                    }
                    if (tag.isContainsLocationInfo) {
                        val dist = tag.LocationInfo.relativeDistance
                        Log.d("TAG", "Tag relative distance: $dist")
                    }

                    processedTags.add(tagId) // Add tag to processed set
                    lastTagReadTime = currentTime // Update last tag read time

                    // Clear processed tags after a delay to allow reprocessing later
                    handler.postDelayed({ processedTags.clear() }, LIST_CLEAR_DELAY_MS)
                    Log.d("TAG", "Tag processed: $processedTags")
                    // Send event with tag ID
                    readTagEvent.sendEvent(tagId)
                }
            }
        }
    }
